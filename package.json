{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "A modular financial backend for processing wagering transactions.",
  "scripts": {
    "start": "bun run dist/main.js",
    "start:dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test eslint.config.mjs",
    "format": "prettier --write src test package.json tsconfig.json tsconfig.build.json eslint.config.mjs docker-compose.yml .github/agents/*.md",
    "format:check": "prettier --check src test package.json tsconfig.json tsconfig.build.json eslint.config.mjs docker-compose.yml .github/agents/*.md",
    "test": "bun test",
    "test:unit": "bun test test/unit test/environment.test.ts test/health.test.ts",
    "db:migrate": "bun run src/database/migrate.ts up",
    "db:rollback": "bun run src/database/migrate.ts down",
    "test:integration": "bun test test/integration"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.6.0",
    "@mikro-orm/migrations": "^6.6.0",
    "@mikro-orm/postgresql": "^6.6.0",
    "ajv": "^8.13.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/bun": "^1.2.5",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
